# ============================================================
# PHM Monorepo — Root Environment Example
# ============================================================
# This file documents ALL environment variables required
# across the entire monorepo for local dev and AWS deployment.
#
# 1. Local dev:  copy apps/web/.env.example → apps/web/.env.local
# 2. AWS:        configure these in Amplify Environment Variables
#                or ECS Task Definition Secrets (via Secrets Manager)
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Local Docker (default):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/phm
# AWS RDS (production):
# DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/phm

# ── AWS Cognito ──────────────────────────────────────────────
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Stripe ───────────────────────────────────────────────────
# Get keys from: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── Email (AWS SES) ──────────────────────────────────────────
PHM_TEAM_EMAIL=team@priorityhomemonitor.com
# AWS_SES_REGION=us-east-1
# AWS_ACCESS_KEY_ID=REPLACE_ME
# AWS_SECRET_ACCESS_KEY=REPLACE_ME
