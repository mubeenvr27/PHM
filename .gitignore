# ============================================================
# PHM Monorepo — .gitignore
# Covers all apps/* and packages/* subdirectories
# ============================================================

# ── Node / npm ───────────────────────────────────────────────
**/node_modules/
**/.pnp
**/.pnp.js
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
package-lock.json

# ── Next.js ──────────────────────────────────────────────────
**/.next/
**/out/
**/build/
**/dist/

# ── Testing ──────────────────────────────────────────────────
**/coverage/

# ── Environment variables (NEVER commit secrets) ──────────────
**/.env
**/.env.local
**/.env.*.local
# .env.example files ARE committed (they contain no secrets)
!**/.env.example

# ── TypeScript build cache ────────────────────────────────────
**/*.tsbuildinfo
**/next-env.d.ts

# ── OS / Editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
~$*

# ── Vercel ───────────────────────────────────────────────────
.vercel

# ── AWS / Amplify ─────────────────────────────────────────────
.amplify-hosting/

# ── Misc ──────────────────────────────────────────────────────
*.log
.vscode/settings.json
